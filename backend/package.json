{
  "name": "formora-backend",
  "version": "1.0.0",
  "description": "Lightweight Node.js Express backend for Formora - Soil Irrigation System with SQLite",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"import('fs').then(fs => { fs.mkdirSync('dist/database', {recursive: true}); fs.copyFileSync('src/database/schema.sql', 'dist/database/schema.sql'); });\"",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
